#!/bin/bash

set -eux -o pipefail
cd "`dirname $0`"/..
export JULIA_PROJECT=$PWD
cd ..
echo $JULIA_PROJECT
# build Julia on the tmpfs set up by provision-worker.sh, if it is mounted
if [ -z "${NANOSOLDIER_BUILDDIR:-}" ] && mountpoint -q /nanosoldier-build; then
    export NANOSOLDIER_BUILDDIR=/nanosoldier-build
fi
exec sudo -u nanosoldier --preserve-env=JULIA_PROJECT,JULIA_DEBUG,NANOSOLDIER_BUILDDIR \
    tmux new-session -A -s nanosoldier bash -c " \
    setarch -R \$HOME/.juliaup/bin/julia run_base_ci.jl \
    2> >(umask 007 && exec setsid -w tee -a run_base_ci.stderr) \
    1> >(umask 007 && exec setsid -w tee -a run_base_ci.stdout)"
